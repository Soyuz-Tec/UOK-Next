{
  "openapi": "3.1.0",
  "info": {
    "title": "UOK Next API",
    "version": "0.6.0",
    "description": "Tenant-authenticated Gate 3 operation and governed read-only reporting contract."
  },
  "servers": [{"url": "/api/v1"}],
  "paths": {
    "/session": {
      "post": {
        "summary": "Create an isolated qualification session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["access_code"],
                "additionalProperties": false,
                "properties": {"access_code": {"type": "string", "minLength": 32, "maxLength": 128}}
              }
            }
          }
        },
        "responses": {"201": {"description": "Signed tenant session"}, "401": {"$ref": "#/components/responses/Error"}}
      },
      "get": {
        "summary": "Read the authenticated identity",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Current identity"}, "401": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/parties": {
      "get": {
        "summary": "List tenant parties",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant party collection"}, "401": {"$ref": "#/components/responses/Error"}}
      },
      "post": {
        "summary": "Create a governed party draft",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateParty"}}}
        },
        "responses": {"201": {"description": "Party draft created"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/parties/{id}": {
      "get": {
        "summary": "Read one tenant party and its evidence metadata",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/PartyId"}],
        "responses": {"200": {"description": "Party detail"}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/parties/{id}/evidence": {
      "post": {
        "summary": "Store verified evidence bytes and submit them for review",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/PartyId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["evidence_id", "expected_version", "classification", "reason", "file"],
                "properties": {
                  "evidence_id": {"type": "string", "format": "uuid"},
                  "expected_version": {"type": "integer", "minimum": 1},
                  "classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
                  "reason": {"type": "string", "minLength": 3, "maxLength": 500},
                  "file": {"type": "string", "format": "binary", "maxLength": 8388608}
                }
              }
            }
          }
        },
        "responses": {"200": {"description": "Evidence verified and review task opened"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/parties/{id}/decision": {
      "post": {
        "summary": "Approve or hold an exact onboarding review task",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/PartyId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PartyDecision"}}}
        },
        "responses": {"200": {"description": "Decision committed"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/products": {
      "get": {
        "summary": "List active tenant products",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant product collection"}}
      },
      "post": {
        "summary": "Create an active governed product",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateProduct"}}}},
        "responses": {"201": {"description": "Product created"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Read one tenant product",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}],
        "responses": {"200": {"description": "Product detail"}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/locations": {
      "get": {
        "summary": "List active tenant locations",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant location collection"}}
      },
      "post": {
        "summary": "Create an active governed location",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateLocation"}}}},
        "responses": {"201": {"description": "Location created"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/locations/{id}": {
      "get": {
        "summary": "Read one tenant location",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}],
        "responses": {"200": {"description": "Location detail"}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/location-references/major-seaports/countries": {
      "get": {
        "summary": "List countries with standardized maritime-port references",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"description": "Versioned country and port-count directory"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/location-references/major-seaports": {
      "get": {
        "summary": "List standardized maritime-port references for one country",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "country_code",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "pattern": "^[A-Za-z]{2}$"}
          }
        ],
        "responses": {
          "200": {"description": "Versioned country seaport directory"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "422": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/sourcing-lanes": {
      "get": {
        "summary": "List governed sourcing lanes",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant sourcing-lane collection"}}
      },
      "post": {
        "summary": "Create a sourcing-lane draft from approved references",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSourcingLane"}}}},
        "responses": {"201": {"description": "Sourcing-lane draft created"}, "404": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/sourcing-lanes/{id}": {
      "get": {
        "summary": "Read one sourcing lane and its evidence metadata",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/LaneId"}],
        "responses": {"200": {"description": "Sourcing-lane detail"}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/sourcing-lanes/{id}/evidence": {
      "post": {
        "summary": "Store verified sourcing evidence and open an exact review task",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/LaneId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/EvidenceUpload"}}}},
        "responses": {"200": {"description": "Evidence verified and task opened"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/sourcing-lanes/{id}/decision": {
      "post": {
        "summary": "Approve or hold an exact sourcing-lane review task",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/LaneId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LaneDecision"}}}},
        "responses": {"200": {"description": "Decision committed"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/purchase-requisitions": {
      "get": {
        "summary": "List governed purchase requisitions",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant requisition collection"}}
      },
      "post": {
        "summary": "Create a requisition from an approved sourcing lane",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateRequisition"}}}},
        "responses": {"201": {"description": "Requisition created"}, "404": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/rfqs": {
      "get": {
        "summary": "List governed RFQs",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant RFQ collection"}}
      },
      "post": {
        "summary": "Open one RFQ for approved invited suppliers",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateRfq"}}}},
        "responses": {"201": {"description": "RFQ opened"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/supplier-quotes": {
      "get": {
        "summary": "List attributable supplier quotes, optionally filtered by RFQ",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant supplier-quote collection"}}
      },
      "post": {
        "summary": "Create a draft quote for an invited approved supplier",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSupplierQuote"}}}},
        "responses": {"201": {"description": "Supplier quote created"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/supplier-quotes/{id}/evidence": {
      "post": {
        "summary": "Verify attributable quote evidence and submit the quote",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/EvidenceUpload"}}}},
        "responses": {"200": {"description": "Quote evidence verified and quote submitted"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/quote-comparisons": {
      "get": {
        "summary": "List deterministic quote comparisons",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant comparison collection"}}
      },
      "post": {
        "summary": "Close an RFQ into an immutable deterministic comparison snapshot",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateQuoteComparison"}}}},
        "responses": {"201": {"description": "Comparison and exact review task created"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/quote-comparisons/{id}/decision": {
      "post": {
        "summary": "Approve or hold an exact quote-comparison review task",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QuoteComparisonDecision"}}}},
        "responses": {"200": {"description": "Comparison decision committed"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/purchase-commitment-proposals": {
      "get": {
        "summary": "List source-bound purchase-commitment proposals",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant commitment-proposal collection"}}
      },
      "post": {
        "summary": "Create a non-binding proposal from one exact approved comparison",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatePurchaseCommitmentProposal"}}}},
        "responses": {"201": {"description": "Non-binding proposal created"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/purchase-commitment-proposals/{id}/evidence": {
      "post": {
        "summary": "Verify proposal evidence and open an exact review task",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/EvidenceUpload"}}}},
        "responses": {"200": {"description": "Evidence verified and proposal submitted"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/purchase-commitment-proposals/{id}/decision": {
      "post": {
        "summary": "Approve or hold an exact proposal review task without creating a commitment",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PurchaseCommitmentProposalDecision"}}}},
        "responses": {"200": {"description": "Proposal decision recorded; no commitment or external effect created"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/shipment-readiness-cases": {
      "get": {
        "summary": "List source-bound shipment-readiness cases",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Tenant shipment-readiness collection"}}
      },
      "post": {
        "summary": "Create a non-executing readiness case from one exact approved proposal",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateShipmentReadinessCase"}}}},
        "responses": {"201": {"description": "Non-executing readiness case created"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/shipment-readiness-cases/{id}/evidence": {
      "post": {
        "summary": "Verify operational readiness evidence and open an exact review task",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/EvidenceUpload"}}}},
        "responses": {"200": {"description": "Evidence verified and readiness submitted"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/shipment-readiness-cases/{id}/decision": {
      "post": {
        "summary": "Record exact GO or HOLD without shipment or downstream execution",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/EntityId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ShipmentReadinessDecision"}}}},
        "responses": {"200": {"description": "Readiness decision recorded; no shipment or downstream effect created"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/operational-reports/{id}": {
      "get": {
        "summary": "Read one reconciled live operational report without business mutation authority",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/EntityId"},
          {"name": "expected_version", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1}}
        ],
        "responses": {
          "200": {"description": "Current report projection, source lineage, freshness, and reconciliation"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "422": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/review-tasks": {
      "get": {
        "summary": "List open human tasks the current actor may decide",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Authorized open tasks"}, "401": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "parameters": {
      "PartyId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "EntityId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "LaneId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}}
    },
    "schemas": {
      "CreateParty": {
        "type": "object",
        "required": ["stable_identifier", "legal_name", "country_code", "party_kind", "reason"],
        "additionalProperties": false,
        "properties": {
          "stable_identifier": {"type": "string", "minLength": 3, "maxLength": 100},
          "legal_name": {"type": "string", "minLength": 2, "maxLength": 200},
          "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "party_kind": {"type": "string", "enum": ["organization", "individual"]},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      },
      "PartyDecision": {
        "type": "object",
        "required": ["decision", "reason", "task_id", "expected_version"],
        "additionalProperties": false,
        "properties": {
          "decision": {"type": "string", "enum": ["approve", "hold"]},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500},
          "task_id": {"type": "string", "format": "uuid"},
          "expected_version": {"type": "integer", "minimum": 1}
        }
      },
      "CreateProduct": {
        "type": "object",
        "required": ["stable_identifier", "name", "product_kind", "base_unit_code", "reason"],
        "additionalProperties": false,
        "properties": {
          "stable_identifier": {"type": "string", "minLength": 3, "maxLength": 100},
          "name": {"type": "string", "minLength": 2, "maxLength": 200},
          "product_kind": {"type": "string", "enum": ["commodity", "packaging", "service"]},
          "base_unit_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{0,15}$"},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      },
      "CreateLocation": {
        "type": "object",
        "required": ["stable_identifier", "name", "country_code", "location_kind", "reason"],
        "additionalProperties": false,
        "properties": {
          "stable_identifier": {"type": "string", "minLength": 3, "maxLength": 100},
          "name": {"type": "string", "minLength": 2, "maxLength": 200},
          "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "location_kind": {"type": "string", "enum": ["country", "region", "locality", "port", "facility"]},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      },
      "CreateSourcingLane": {
        "type": "object",
        "required": ["stable_identifier", "name", "supplier_party_id", "product_id", "origin_location_id", "destination_location_id", "reason"],
        "additionalProperties": false,
        "properties": {
          "stable_identifier": {"type": "string", "minLength": 3, "maxLength": 100},
          "name": {"type": "string", "minLength": 2, "maxLength": 200},
          "supplier_party_id": {"type": "string", "format": "uuid"},
          "product_id": {"type": "string", "format": "uuid"},
          "origin_location_id": {"type": "string", "format": "uuid"},
          "destination_location_id": {"type": "string", "format": "uuid"},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      },
      "EvidenceUpload": {
        "type": "object",
        "required": ["evidence_id", "expected_version", "classification", "reason", "file"],
        "properties": {
          "evidence_id": {"type": "string", "format": "uuid"},
          "expected_version": {"type": "integer", "minimum": 1},
          "classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500},
          "file": {"type": "string", "format": "binary", "maxLength": 8388608}
        }
      },
      "LaneDecision": {
        "type": "object",
        "required": ["decision", "reason", "task_id", "expected_version"],
        "additionalProperties": false,
        "properties": {
          "decision": {"type": "string", "enum": ["approve", "hold"]},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500},
          "task_id": {"type": "string", "format": "uuid"},
          "expected_version": {"type": "integer", "minimum": 1}
        }
      },
      "CreateRequisition": {
        "type": "object",
        "required": ["stable_identifier", "sourcing_lane_id", "quantity", "unit_code", "required_by", "reason"],
        "additionalProperties": false,
        "properties": {
          "stable_identifier": {"type": "string", "minLength": 3, "maxLength": 100},
          "sourcing_lane_id": {"type": "string", "format": "uuid"},
          "quantity": {"type": ["string", "number"], "exclusiveMinimum": 0},
          "unit_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{0,15}$"},
          "required_by": {"type": "string", "format": "date"},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      },
      "CreateRfq": {
        "type": "object",
        "required": ["stable_identifier", "requisition_id", "expected_version", "settlement_currency_code", "response_deadline", "supplier_party_ids", "reason"],
        "additionalProperties": false,
        "properties": {
          "stable_identifier": {"type": "string", "minLength": 3, "maxLength": 100},
          "requisition_id": {"type": "string", "format": "uuid"},
          "expected_version": {"type": "integer", "minimum": 1},
          "settlement_currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "response_deadline": {"type": "string", "format": "date-time"},
          "supplier_party_ids": {"type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      },
