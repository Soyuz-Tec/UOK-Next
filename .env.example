# Local development only. Production secrets belong in the deployment secret store.
UOK_DB_HOST=127.0.0.1
UOK_DB_PORT=15432
UOK_DB_USER=uok_next
# Required. Generate a clone-local credential with scripts/start_local_postgres.ps1.
UOK_DB_PASSWORD=
UOK_APP_DB_PASSWORD=replace-with-a-random-local-app-password
UOK_DB_NAME=uok_next_dev
UOK_TEST_DB_NAME=uok_next_test

# Local container qualification only. Generate new values for every deployment.
UOK_LOCAL_SECRET_KEY_BASE=replace-with-at-least-64-random-bytes
UOK_LOCAL_METRICS_TOKEN=replace-with-at-least-32-random-bytes
UOK_HTTP_PORT=18089

# Local S3-compatible evidence-object dependency. Generate fresh credentials
# for every qualification run; never reuse these values in production.
UOK_OBJECT_STORE_ACCESS_KEY=
UOK_OBJECT_STORE_SECRET_KEY=
UOK_OBJECT_STORE_PORT=18333
UOK_OBJECT_STORE_BUCKET=uok-evidence
